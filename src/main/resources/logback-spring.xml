<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- 로그 저장 위치 -->
    <property name="LOG_PATH" value="/app/logs"/>


    <!-- ============================== -->
    <!-- 교환 관련 일반 로그 -->
    <!-- ============================== -->

    <appender name="EXCHANGE_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/exchange.log</file>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%level] %msg%n
            </pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/exchange.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>7</maxHistory>

        </rollingPolicy>

    </appender>


    <!-- ============================== -->
    <!-- 경고 로그 -->
    <!-- ============================== -->

    <appender name="WARNING_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/warning.log</file>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%level] %msg%n
            </pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/warning.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>7</maxHistory>

        </rollingPolicy>

    </appender>


    <!-- ============================== -->
    <!-- ERROR 로그 -->
    <!-- ============================== -->

    <appender name="ERROR_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/error.log</file>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%level] %msg%n
            </pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/error.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>7</maxHistory>

        </rollingPolicy>

    </appender>


    <!-- 용도별 Logger -->

    <logger name="EXCHANGE_LOG"
            level="INFO"
            additivity="false">
        <appender-ref ref="EXCHANGE_FILE"/>
    </logger>

    <logger name="WARNING_LOG"
            level="WARN"
            additivity="false">
        <appender-ref ref="WARNING_FILE"/>
    </logger>

    <logger name="ERROR_LOG"
            level="ERROR"
            additivity="false">
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%level] %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>
    <!-- 기존 Spring Boot 콘솔 로그 -->

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>